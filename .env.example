# =============================================================================
# SvapNora — environment configuration (placeholders only, NEVER commit secrets)
# Copy this file to `.env` at the repository root and fill in real values.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
# Comma-separated list of allowed browser origins for CORS + CSRF checks.
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL) ----------------------------------------------------
# Local docker-compose default. Use a managed Postgres URL in production.
DATABASE_URL=postgresql://svapnora:svapnora@localhost:5432/svapnora?schema=public

# --- Sessions & Security ------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
SESSION_TTL_HOURS=12
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Set to true in production (requires HTTPS).
TRUST_PROXY=false
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8
CONTACT_RATE_LIMIT_WINDOW_MINUTES=60
CONTACT_RATE_LIMIT_MAX_ATTEMPTS=5

# --- Client accounts ----------------------------------------------------------
# Session lifetime for public client-portal accounts (separate cookie from admins).
USER_SESSION_TTL_HOURS=168
# Email verification + password reset link lifetimes.
VERIFY_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_HOURS=1

# --- Initial administrator provisioning (used by `npm run admin:create` only) --
# The password is hashed with Argon2id and never stored in plain text.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=change-me-strong-password
ADMIN_ROLE=OWNER

# --- Email provider (contact form notifications) ------------------------------
# EMAIL_PROVIDER=none  -> submissions are stored but not emailed (default).
# EMAIL_PROVIDER=smtp  -> SMTP delivery using the settings below.
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SvapNora <no-reply@example.com>
# Where contact notifications are delivered.
CONTACT_TO_EMAIL=

# --- Payments -----------------------------------------------------------------
# PAYMENT_PROVIDER=none -> demo mode (records can be created/verified manually).
# PAYMENT_PROVIDER=stripe | razorpay -> real gateway integration.
PAYMENT_PROVIDER=none
PAYMENTS_CURRENCY=USD

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Feature flags ------------------------------------------------------------
# Show a clearly-labelled demo banner across the admin payments module.
PAYMENTS_DEMO_MODE=true
